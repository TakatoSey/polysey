# One bot instance = one Telegram token + one database. A live bot needs its
# own token from @BotFather and its own database; the bot refuses to start if
# another process polls the same token, or if this database was claimed by a
# bot in the other mode. See docs/live-trading.md.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USER_ID=replace_me
DATABASE_URL=postgresql+asyncpg://polycopy:polycopy@db:5432/polycopy
# Used by docker-compose for the bundled PostgreSQL. Change all four together
# (and keep DATABASE_URL in step) for a second instance on the same host.
POSTGRES_DB=polycopy
POSTGRES_USER=polycopy
POSTGRES_PASSWORD=polycopy
PAPER_INITIAL_BALANCE=100
POLL_INTERVAL_SECONDS=0.5
MAINTENANCE_INTERVAL_SECONDS=2
# How long an unresolved market state is reused. This, not the maintenance
# loop, decides how fast a settled outcome is noticed. Lower = faster = more requests.
RESOLUTION_CACHE_SECONDS=5
EXIT_RETRY_ENABLED=true
EXIT_RETRY_SECONDS=1
# Signals arrive in bursts; a slot is held for the whole metadata+book fetch, so
# a burst larger than this waits before it even starts its first request.
COPY_PREPARE_CONCURRENCY=16
COPY_QUEUE_LIMIT=256
RTDS_ENABLED=true
# Extra artificial delay; network/API latency is measured naturally. Keep 0 for realistic VPS mode.
COPY_LATENCY_SECONDS=0
# Diagnostic thresholds shown in latency logs; age alone does not reject a BUY.
MAX_SIGNAL_AGE_RTDS_SECONDS=2
MAX_SIGNAL_AGE_REST_SECONDS=5
DEFAULT_TRADE_SIZE=5
# Initial limit for a NEW account. Existing account limits are stored in the DB;
# change them with /setmax. In smart mode this is per series, INCLUDING fees.
MAX_TRADE_SIZE=30
# Base budget: 5% of OUR free cash at the start of a grouped leader entry.
COPY_BALANCE_PCT=0.05
# Legacy mode only: DEFAULT_TRADE_SIZE and LEADER_ORDER_SCALE.
LEADER_ORDER_SCALE=0.10
SMART_SIZING_ENABLED=true
# Purchases by one leader/outcome inside this source-time window form one series.
SMART_SIZING_BURST_SECONDS=5
SMART_SIZING_MAX_MULTIPLIER=3
SMART_SIZING_MIN_SAMPLES=3
SMART_SIZING_STATS_REFRESH_SECONDS=86400
# Meaningful series are raised to the executable minimum; tiny fragments accumulate.
MIN_COPY_NOTIONAL=1.10
# Current open cost basis cap per outcome, INCLUDING fees in smart mode.
MAX_OUTCOME_EXPOSURE=50
# Share of equity (cash + open cost) always kept as cash, so a burst of signals
# cannot deploy the whole balance. 0.25 leaves at most 75% deployed.
MIN_CASH_RESERVE_PCT=0.25
# A market whose minimum order costs more than this multiple of the base budget
# is skipped instead of being funded above the base percentage.
SIZING_FLOOR_MAX_MULTIPLE=2
# Above 1, how far an entry departs from that leader's own norm counts for more
# than the ratio alone. 1 = plain proportional.
SIZING_CONVICTION_POWER=1.5
# Share of the contract-price nudge applied. 0 ignores odds, 1 is the full swing.
SIZING_ODDS_WEIGHT=0.5
# Human cents: 5 means $0.05, NOT 5% of the leader price.
# Initialized once in execution_policy; afterwards use /setslippage 5 in Telegram.
DEFAULT_SLIPPAGE_CENTS=5
# Remove DEFAULT_SLIPPAGE_BPS from old env files: it is no longer used for execution.
# ---------------------------------------------------------------------------
# Real money. Leave TRADING_MODE=paper until you have read docs/live-trading.md.
# ---------------------------------------------------------------------------
TRADING_MODE=paper
# Live mode refuses to start unless this is exactly I_UNDERSTAND_REAL_MONEY.
# LIVE_CONFIRM=
# The key that SIGNS orders. Fund the wallet below, not necessarily this key.
# Keep it out of git, chats and backups; anyone holding it can move the money.
# POLYMARKET_PRIVATE_KEY=
# The wallet that HOLDS the USDC. For a Polymarket account it is the proxy
# address shown in the UI, not the address of the signing key.
# POLYMARKET_FUNDER=
# 0 = the signing key holds the funds itself (plain EOA)
# 1 = Polymarket email/Magic account (proxy wallet)  <- most common
# 2 = Polymarket account created from a browser wallet (proxy wallet)
POLYMARKET_SIGNATURE_TYPE=1
POLYGON_CHAIN_ID=137
# FAK takes what is available now and cancels the rest, like paper mode does.
LIVE_ORDER_TYPE=FAK
# Signs orders and logs them without sending anything. Use it for the first run.
LIVE_DRY_RUN=false
# Hard ceiling per order, after every other sizing limit.
LIVE_MAX_ORDER_USDC=25
# Realized loss since UTC midnight that stops new entries for the rest of the day.
LIVE_MAX_DAILY_LOSS_USDC=25
# How often cash and positions are re-read from Polymarket.
LIVE_STATE_REFRESH_SECONDS=5
# Divergence between our ledger and the exchange that stops new entries.
LIVE_DRIFT_TOLERANCE_USDC=1

POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CLOB=https://clob.polymarket.com
POLYMARKET_GAMMA=https://gamma-api.polymarket.com
DEFAULT_LEADER_ADDRESS=0x090a9efe46c0e42e4fd598cd81be011ad72f27e7
LOG_LEVEL=INFO
