TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USER_ID=replace_me
DATABASE_URL=postgresql+asyncpg://polycopy:polycopy@db:5432/polycopy
PAPER_INITIAL_BALANCE=100
POLL_INTERVAL_SECONDS=0.5
MAINTENANCE_INTERVAL_SECONDS=2
EXIT_RETRY_ENABLED=true
EXIT_RETRY_SECONDS=1
COPY_PREPARE_CONCURRENCY=8
COPY_QUEUE_LIMIT=256
RTDS_ENABLED=true
# Extra artificial delay; network/API latency is measured naturally. Keep 0 for realistic VPS mode.
COPY_LATENCY_SECONDS=0
MAX_SIGNAL_AGE_RTDS_SECONDS=2
MAX_SIGNAL_AGE_REST_SECONDS=5
DEFAULT_TRADE_SIZE=5
# Initial limit for a NEW account. Existing account limits are stored in the DB;
# change them with /setmax. In smart mode this is per series, INCLUDING fees.
MAX_TRADE_SIZE=30
# Base budget: 5% of OUR free cash at the start of a grouped leader entry.
COPY_BALANCE_PCT=0.05
# Legacy mode only: DEFAULT_TRADE_SIZE and LEADER_ORDER_SCALE.
LEADER_ORDER_SCALE=0.10
SMART_SIZING_ENABLED=true
# Fixed source-time buckets; no extra wait is added to execution.
SMART_SIZING_BURST_SECONDS=2
SMART_SIZING_MAX_MULTIPLIER=3
SMART_SIZING_MIN_SAMPLES=3
SMART_SIZING_STATS_REFRESH_SECONDS=86400
# No forced rounding up: small adds accumulate only in the same entry bucket.
MIN_COPY_NOTIONAL=1.10
# Current open cost basis cap per outcome, INCLUDING fees in smart mode.
MAX_OUTCOME_EXPOSURE=50
# Human cents: 5 means $0.05, NOT 5% of the leader price.
# Initialized once in execution_policy; afterwards use /setslippage 5 in Telegram.
DEFAULT_SLIPPAGE_CENTS=5
# Remove DEFAULT_SLIPPAGE_BPS from old env files: it is no longer used for execution.
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_CLOB=https://clob.polymarket.com
POLYMARKET_GAMMA=https://gamma-api.polymarket.com
DEFAULT_LEADER_ADDRESS=0x090a9efe46c0e42e4fd598cd81be011ad72f27e7
LOG_LEVEL=INFO
